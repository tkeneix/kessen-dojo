# kessen-dojo 環境変数テンプレート
# 使い方: このファイルを .env にコピーし、各APIキーの値を設定する
#   cp .env.example .env
# run-once-rounds3.sh など実行スクリプトは `source .env` で読み込む
# 注意: .env は .gitignore 対象。実キーをコミットしないこと

# xAI (Grok ペルソナ用)
export XAI_API_KEY=

# Google Gemini (google-genai)
export GOOGLE_API_KEY=

# OpenAI (OpenAI ペルソナ / LLM judge 用)
export OPENAI_API_KEY=
